# ── Required ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Optional fallbacks ────────────────────────────────────────────────
# OpenRouter powers the cross-provider model fallback (gpt-4o-mini / gpt-4o …)
# when the Gemini key hits its quota. Strongly recommended for smooth operation.
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# ── App settings ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Deployment ────────────────────────────────────────────────────────
# Set to "true" on cloud (Railway/Render) — runs Chromium in headless mode
HEADLESS=false
